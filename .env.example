# Copy to .env (or set in your orchestrator). Full reference: docs/ENVIRONMENT.md
ORIGIN=https://coves.social
PUBLIC_INSTANCE_URL=https://coves.social
PUBLIC_INTERNAL_INSTANCE=http://appview:8080
ALLOW_HTTP_INTERNAL_INSTANCE=true
#PUBLIC_LOCK_TO_INSTANCE=true
#PUBLIC_SSR_ENABLED=false

# Server-side error logging. Stack traces are written to the structured log
# lines by default (they pass through the secret scrubber first). Set to 0 to
# omit them, e.g. on a very noisy deployment.
# LOG_STACKS=0
